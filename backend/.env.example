DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/claim_review
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Storage: "local" or "s3"
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads

# S3 (only if STORAGE_BACKEND=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=claim-review-uploads

# App
APP_ENV=development
CORS_ORIGINS=http://localhost:3000
MAX_FILE_SIZE_MB=25
